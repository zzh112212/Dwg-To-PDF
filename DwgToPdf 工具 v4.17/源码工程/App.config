<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- v4.6：高 DPI 适配（PerMonitorV2）——高分屏 125%/150% 缩放下界面清晰不模糊。
       .NET Framework 4.7+ 支持 app.config 声明，无需清单文件。 -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <System.Windows.Forms.Application dpiAwareness="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
